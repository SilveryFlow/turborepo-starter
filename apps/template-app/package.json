    "@repo/config-typescript": "workspace:*",
    "@repo/config-unocss": "workspace:*",
    "@repo/config-vite": "workspace:*",
    "@types/jsdom": "catalog:",
    "@types/node": "catalog:",
    "@unocss/eslint-config": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
